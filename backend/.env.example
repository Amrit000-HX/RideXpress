# ── Server ──────────────────────────
PORT=5000

# ── MongoDB ──────────────────────────
# Local:   mongodb://127.0.0.1:27017/ridexpress
# Atlas:   mongodb+srv://<user>:<password>@cluster.mongodb.net/ridexpress?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/ridexpress

# ── JWT ──────────────────────────────
# Generate a strong random secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d

# ── CORS ─────────────────────────────
CLIENT_ORIGIN=http://localhost:5173

# ── Admin Seed (used only by scripts/seedAdmin.js) ───────────
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@ridexpress.com
ADMIN_PASSWORD=Admin@12345
